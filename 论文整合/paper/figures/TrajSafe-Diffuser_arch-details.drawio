  <diagram id="d3" name="D3-凸区域与安全走廊">
    <mxGraphModel dx="2400" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1420" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d3_title" value="D3 ｜ §3.2-c 确定性几何链：候选骨架（离线缓存）→ 椭圆度量 → 贪心半平面 → 凸区域 → 重叠检验 / 桥接 → 冻结走廊" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2200" height="28" as="geometry"/></mxCell>
        <mxCell id="d3_foot" value="对应代码：geometry/thinning.py · skeleton_graph.py · skeleton_paths.py · convex_region.py:EllipseRegionBuilder · safety_corridor.py:build_safety_corridor ｜ 本页全部为零参数确定性计算，无任何可训练权重" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="2320" height="22" as="geometry"/></mxCell>
        <mxCell id="d3_legend" value="图例：圆形 + = 残差相加　立方体 = 张量 / 状态　紫色虚线箭 = 时间步 \(h_t\) 注入　蓝色虚线箭 = 场景记忆 \(C_G/C_E\)　红色虚线箭 = 历史安全反馈　绿色虚线箭 = 走廊 / 约束包　紫色虚线框 = 重复模块" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="2320" height="22" as="geometry"/></mxCell>
        <mxCell id="d3_fa" value="候选骨架与候选集（离线预处理，缓存复用）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#999999;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#999999;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="540" height="820" as="geometry"/></mxCell>
        <mxCell id="d3_occ" value="𝒪 [B,1,256,256]（障碍外扩 4 格）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="d3_thin" value="Guo-Hall 细化★自由空间★ → 一像素宽骨架&lt;br&gt;+ 拓扑校验（连通分量 / 孔洞数不变）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="248" width="320" height="62" as="geometry"/></mxCell>
        <mxCell id="d3_graph" value="压缩骨架图 G=(V,E)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="328" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d3_route" value="起终点接入可见骨架节点&lt;br&gt;（anchor_candidates = 16）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="394" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="d3_ksp" value="Yen K-最短路（raw_k = 128）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="470" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d3_safe" value="安全拼接（connector + branch + 簇内桥接）&lt;br&gt;去重 Jaccard ≤ 0.75，长度比 ≤ 1.5" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="536" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="d3_res" value="弧长重采样 → L = 128 点" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="614" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d3_set" value="CandidateSet：M = 4（padded + mask）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="680" width="320" height="52" as="geometry"/></mxCell>
        <mxCell id="d3_ctok_t0" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="688" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_ctok_t1" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="453" y="688" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_ctok_t2" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="476" y="688" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_ctok_t3" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="499" y="688" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_lab" value="训练标签（离线）&lt;br&gt;· soft_topology_target = softmax(−nDTW(gt, P_m)/τ)，τ = 0.05&lt;br&gt;· GT waypoint 投影到选中折线 → 单调弧长 progress&lt;br&gt;· 旧的 5 维 path_features [x,y,tx,ty,u] 与手工 progress 已不进网络&lt;br&gt;· 候选折线仅提供 S_m 的 2D 坐标与 dense 几何 Γ_m（1280 点）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="d3_fb" value="椭圆 → 度量 → 贪心半平面 → 凸区域" style="group" vertex="1" parent="1"><mxGeometry x="620" y="130" width="560" height="820" as="geometry"/></mxCell>
        <mxCell id="d3_in" value="\(c_i\) [B,Q,2] 与 shape4（D2）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="180" width="320" height="52" as="geometry"/></mxCell>
        <mxCell id="d3_metric" value="度量 \(Q=uu^{\top}/a^2+vv^{\top}/b^2\)&lt;br&gt;轴 clamp 到 [0.002, 2.0]" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="320" height="62" as="geometry"/></mxCell>
        <mxCell id="d3_pts" value="候选点集：窗口 0.35 内障碍点&lt;br&gt;+ 边界环点 + 地图边界 4 面" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="320" height="62" as="geometry"/></mxCell>
        <mxCell id="d3_sort" value="Mahalanobis 距离升序" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="410" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d3_face" value="取最近未覆盖点 \(p\)：&lt;br&gt;\(\hat n=Q(p-c)/\|Q(p-c)\|\)，\(b=\hat n\cdot p-\mathrm{margin}\)&lt;br&gt;→ 新半平面；丢弃被覆盖点" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="476" width="320" height="76" as="geometry"/></mxCell>
        <mxCell id="d3_valid" value="有效性：面数 ≥ 3 且法向角隙 &lt; π（有界）&lt;br&gt;Shoelace 面积 &gt; 0" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="570" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="d3_out" value="\(\{x:A_ix\le b_i\}\)（mask / valid）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="646" width="320" height="52" as="geometry"/></mxCell>
        <mxCell id="d3_fc" value="重叠检验与桥接（沿 \(\Gamma_{m^*}\) 顺序）" style="group" vertex="1" parent="1"><mxGeometry x="1500" y="130" width="860" height="560" as="geometry"/></mxCell>
        <mxCell id="d3_inter" value="相邻区域交集 = 两个区域★全部半平面★的交集（无需多边形裁剪）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="180" width="780" height="52" as="geometry"/></mxCell>
        <mxCell id="d3_rho" value="\(\rho_i=\mathrm{Area}(\mathcal P_i\cap\mathcal P_{i+1})/(\min\{A\}+\epsilon)\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="252" width="320" height="56" as="geometry"/></mxCell>
        <mxCell id="d3_test" value="\(\rho_i\ge\) min_overlap_ratio = 0.10 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1900" y="252" width="420" height="56" as="geometry"/></mxCell>
        <mxCell id="d3_bridge" value="桥接：在 \(\Gamma_{m^*}(s_{mid})\) 处插点种子区域（quadratic = I，各向同性）&lt;br&gt;要求与左右都满足重叠率，否则 corridor.valid = False" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="328" width="780" height="64" as="geometry"/></mxCell>
        <mxCell id="d3_ok" value="接受：走廊按 \(\Gamma_{m^*}\) 顺序排列 cells = [\(\mathcal P_1\dots\mathcal P_R\)]" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="412" width="780" height="48" as="geometry"/></mxCell>
        <mxCell id="d3_corr" value="SafetyCorridor（冻结）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="480" width="420" height="54" as="geometry"/></mxCell>
        <mxCell id="d3_rtok_t0" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1990" y="488" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_rtok_t1" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2013" y="488" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_rtok_t2" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2036" y="488" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_rtok_t3" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2059" y="488" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_rtok_t4" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2082" y="488" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_rtok_t5" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2105" y="488" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_rtok_lbl" value="R 个凸区域" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1950" y="508" width="218" height="18" as="geometry"/></mxCell>
        <mxCell id="d3_sh" value="区域共享（加速）：region_stride = s，每第 s 个 anchor 一个区域；&lt;br&gt;最后一个 anchor 永远保留（s=1 → 128；s=8 → 17）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="560" width="780" height="62" as="geometry"/></mxCell>
        <mxCell id="d3_exit" value="出口：走廊半平面与 Bézier 约束包 → D6；\(S_m\) 的 2D 坐标 → D1；\(\Gamma_{m^*}\) → D2" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1540" y="640" width="780" height="40" as="geometry"/></mxCell>
        <mxCell id="d3_nt1" value="关键参数" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1150" height="380" as="geometry"/></mxCell>
        <mxCell id="d3_nt1_0" value="safety_margin = 0.02　obstacle_window_half = 0.35　obstacle_dilation = 0" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1030" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt1_1" value="ellipse_axis_min / max = 0.002 / 2.0　corridor_chunk_size = 512" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1052" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt1_2" value="min_overlap_ratio = 0.10（实测分布另行记录，代码里绝不写死）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1074" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt1_3" value="bridge.enabled = true，max_bridge_per_gap = 1（非递归，V1 只允许一个）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1096" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt1_4" value="topology_trials = 4：一条候选闭不上就换下一条" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1118" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt1_5" value="region_stride ∈ {1, 8} → 基础区域 128 / 17（论文表 4-2）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1140" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt1_6" value="map_boundary_faces = true：\(\pm x\le1-m,\ \pm y\le1-m\)，m = safety_margin" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1162" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt2" value="易错点（代码为准）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1230" y="1000" width="1130" height="380" as="geometry"/></mxCell>
        <mxCell id="d3_nt2_0" value="· 交集用「全部半平面」而不是多边形裁剪（凸 ∩ 凸 仍是多面体）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1030" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt2_1" value="· 有界性判据是法向角隙 &lt; π：3 个面即可，没有「至少 4 面」规则" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1052" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt2_2" value="· 桥接用各向同性度量 quadratic = I，不是插值出来的「桥接椭圆」" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1074" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt2_3" value="· 走廊 / 桥接单元 / 约束包只构建一次并冻结，绝不每步重建" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1096" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt2_4" value="· 区域共享时最后一个 anchor 绝不参与共享（端点区域必须独立）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1118" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt2_5" value="· 输出区域必须与碰撞度量一致：地图边界以半空间形式进入约束集" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1140" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d3_nt2_6" value="· 未通过检查的区域（无效面 / 面积 0）会让整条走廊失效并回退" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1162" width="1102" height="20" as="geometry"/></mxCell>
