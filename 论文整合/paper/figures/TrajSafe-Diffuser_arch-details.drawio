        <mxCell id="d4_hctrl" value="\(H_{ctrl}\) [B,C,128] → 反馈门控（D7）/ MatchBlock（D1）/ head_p（D5）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="732" width="860" height="54" as="geometry"/></mxCell>
