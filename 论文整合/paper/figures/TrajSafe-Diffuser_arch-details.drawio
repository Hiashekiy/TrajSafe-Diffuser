        <mxCell id="d1_nt1_1" value="· 无 Chamfer 特征、无候选长度特征、无 coarse token、骨架无切线/弧长输入" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1202" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt1_2" value="· SkeletonEncoder 永远看不到 \(h_t\) / \(C_G\) / \(C_E\)（纯静态几何编码）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1224" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt1_3" value="· \(\Phi_{xy}\) 与 PE_1D 在 轨迹 / 骨架 / 地图栅格 / 椭圆中心 之间共享同一实例" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1246" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt1_4" value="· M 个候选一次批算：MatchBlock 参数在 M 维完全共享 → \(R\) [B,M,C,128]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1268" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt1_5" value="· \(R\) 同时供 TopologyHead 与 PathFeatureHead 使用，中间不再有额外投影" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1290" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt2" value="关键尺寸（论文配置：C=48 基座）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1230" y="1150" width="1130" height="200" as="geometry"/></mxCell>
        <mxCell id="d1_nt2_0" value="M = 4 候选拓扑　L = 128 候选点（= num_safety_queries）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1180" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt2_1" value="C = 48 控制点（config.yaml 旧值为 32，勿混用）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1202" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt2_2" value="D = 128　heads = 4　\(d_h\) = 32　FFN = 512　dropout = 0" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1224" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt2_3" value="\(N_S\) = 2（骨架）　\(N_T\) = 8（主干，D4）　\(N_F\) = 3（D5）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1246" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt2_4" value="\(C_G\): 16×16 → 256 token　\(C_E\): 32×32 → 1024 token（D4）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1268" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d1_nt2_5" value="rel_bias_len = 128（相对索引偏置表长度，与 token 数解耦）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1290" width="1102" height="20" as="geometry"/></mxCell>
