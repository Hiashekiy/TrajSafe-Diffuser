        <mxCell id="d2_fd_0" value="\(B_{ij}=\mathrm{clamp}(-\bar\alpha_t\cdot\|c_i-g_j\|^2/(2\sigma_{geo}^2),\;-\mathrm{clip},\;0)\)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1454" y="610" width="892" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_fd_1" value="\(\sigma_{geo}=0.25\)，clip = 8.0；代码必须用 \(ab^2\)（传入的 ab 是 \(\sqrt{\bar\alpha_t}\)）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1454" y="632" width="892" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_fd_2" value="\(g_j\) 为 \(C_E\) 的 32×32 栅格中心；去噪越接近 t=0（\(\bar\alpha_t\to1\)）偏置越强" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1454" y="654" width="892" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_fd_3" value="出口：\(H_{ell}\) → D5（SafetyControlFusion 的 K/V）；shape4 → D3（椭圆→半平面→凸区域）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1454" y="676" width="892" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_fd_4" value="无 center head、无 learned progress：\(c_i\) 完全来自固定 progress 与 dense skeleton" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1454" y="698" width="892" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt1" value="结构约束（易错点）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1150" height="380" as="geometry"/></mxCell>
        <mxCell id="d2_nt1_0" value="· 没有 center head：椭圆中心来自固定 progress 与 dense skeleton 曲线" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1030" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt1_1" value="· 没有 learned progress / 累积 softplus / alignment loss（旧报告的 ProgressHead 已删除）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1052" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt1_2" value="· fine geometry \(C_E\) 只查询一次（本页中间栏）；D-C48 消融里整条椭圆链路不存在" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1074" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt1_3" value="· bias 由 diffusion strength 加权，4 个 head 共享同一 bias 张量" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1096" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt1_4" value="· \(h_t\) 在本页有两个注入点：cross-attn 的 AdaLN 与 shape head 的 AdaLN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1118" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt1_5" value="· 输出是 4 维 shape4（不是 a,b,θ 三个数）：log a, log b, cos2θ, sin2θ" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1140" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt1_6" value="· shape 监督用原始 log 轴（不截断）；只有需要物理半轴时才 exp + clamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1162" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt2" value="关键尺寸" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1230" y="1000" width="1130" height="380" as="geometry"/></mxCell>
        <mxCell id="d2_nt2_0" value="Q = 128（= num_safety_queries = L；\(s_i=i/127\)）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1030" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt2_1" value="D = 128　heads = 4　\(d_h\) = 32　MLP_C hidden = 256" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1052" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt2_2" value="\(\sigma_{geo}\) = 0.25　bias clip = 8.0　\(C_E\) = 32×32 → 1024 token" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1074" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt2_3" value="椭圆标签（离线）：local_radius = 0.25 m，36 个朝向，8 次二分" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1096" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt2_4" value="区域侧参数：ellipse_axis_min = 0.002，ellipse_axis_max = 2.0（D3）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1118" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d2_nt2_5" value="shape 监督：原始 log 轴回归 + soft-IoU + 椭圆安全项" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1140" width="1102" height="20" as="geometry"/></mxCell>
