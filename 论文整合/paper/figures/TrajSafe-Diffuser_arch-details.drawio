  <diagram id="d6" name="D6-控制点ALM与硬投影">
    <mxGraphModel dx="2400" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1420" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d6_title" value="D6 ｜ §3.4-a 控制点增广拉格朗日修正：Bézier 约束包 → 内循环（解析梯度 / Cholesky 步 / 信任域 / 控制轴低通）→ 末端 LP 硬投影" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2200" height="28" as="geometry"/></mxCell>
        <mxCell id="d6_foot" value="对应代码：geometry/bspline_constraints.py:bezier_extraction/build_constraint_pack · diffusion/bspline_alm.py:137 bspline_alm_correct · :318 bspline_hard_project · sampler.py:865-877 ｜ 无任何可训练权重（对偶 λ 是状态，不是参数）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="2320" height="22" as="geometry"/></mxCell>
        <mxCell id="d6_legend" value="图例：圆形 + = 残差相加　立方体 = 张量 / 状态　紫色虚线箭 = 时间步 \(h_t\) 注入　蓝色虚线箭 = 场景记忆 \(C_G/C_E\)　红色虚线箭 = 历史安全反馈　绿色虚线箭 = 走廊 / 约束包　紫色虚线框 = 重复模块" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="2320" height="22" as="geometry"/></mxCell>
        <mxCell id="d6_fa" value="① 冻结约束包：走廊 → Bézier 线性不等式（一次性）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#999999;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#999999;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="560" height="700" as="geometry"/></mxCell>
        <mxCell id="d6_corr" value="冻结走廊 \(\{\mathcal P_r\}\) + anchors" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="d6_resp" value="责任区间：相邻 anchor 取中点" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d6_sub" value="精确细分 \(U=\{\tau_j\}\cup\{\)原节点\(\}\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="316" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="d6_bez" value="每段三次 Bézier 提取：\(\beta_r=E_rQ\)&lt;br&gt;\(E_l\) [4,C]（零参数、可微）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="392" width="320" height="66" as="geometry"/></mxCell>
        <mxCell id="d6_pack" value="BSplineConstraintPack&lt;br&gt;extraction / piece_A / b / mask" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="476" width="320" height="66" as="geometry"/></mxCell>
        <mxCell id="d6_ptok_t0" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="552" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d6_ptok_t1" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="443" y="552" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d6_ptok_t2" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="466" y="552" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d6_ptok_t3" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="489" y="552" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d6_ptok_t4" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="512" y="552" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d6_why" value="为什么用 Bézier：由凸包性质，只要约束一段的 4 个 Bézier 控制点，&lt;br&gt;整条三次段就必然落在该段的职责凸区域内。&lt;br&gt;&lt;br&gt;因此安全修正始终作用在★控制点★上，而不是解码后的密集采样点；&lt;br&gt;每段贡献 4 × 该段面数 个标量不等式（num_constraints）。" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="520" height="190" as="geometry"/></mxCell>
        <mxCell id="d6_fb" value="② ALM 内循环（每个 GUIDED 反向步一次）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#9673A6;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="900" height="900" as="geometry"/></mxCell>
        <mxCell id="d6_g" value="约束状态：\(\beta=E_lQ\)，\(g=A\beta-b\)（face_mask 外恒 0）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="d6_w" value="\(\omega=[\lambda+\rho g]_+\odot\mathrm{mask}\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="244" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="d6_grad" value="解析梯度：force \(=\omega\cdot A\) → \(\nabla_Q=\sum_lE_l^{\top}\mathrm{force}\)&lt;br&gt;（面 → Bézier 控制点 → 控制点；端点行置 0）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="308" width="820" height="62" as="geometry"/></mxCell>
        <mxCell id="d6_solve" value="牛顿型步：\(\mathrm{system}=I+\eta(\mathrm{prox}B_i^{\top}B_i+w_sS_i^{\top}S_i)\)&lt;br&gt;预先 Cholesky 分解 → 解 \(\mathrm{system}x=\mathrm{target}[1{:}C{-}1]\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="388" width="820" height="62" as="geometry"/></mxCell>
        <mxCell id="d6_trust" value="信任域：\(\max_i\|(B\,\mathrm{step})_i\|\le\) max_curve_step_scene（超出则缩放）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="468" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="d6_smooth" value="控制轴三角低通（kernel = 3）：让邻居控制点跟随衰减" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="536" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="d6_apply" value="\(Q\leftarrow Q+\mathrm{step}\)；端点钉死；累计 \(\Delta=Q-Q^{raw}\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="604" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="d6_dual" value="对偶更新：\(\lambda\leftarrow[\lambda+\rho g_{new}]_+\odot\mathrm{mask}\)（跨步热启动）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="672" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="d6_stop" value="整批 \(\max g\le\) constraint_tol ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="750" width="420" height="52" as="geometry"/></mxCell>
        <mxCell id="d6_qsafe" value="\(Q_t^{safe}\) [B,C,2] + λ" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="828" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="d6_bud" value="预算：inner_steps = 10；首次激活用 activation_inner_steps = 8；max_steps 逐样本裁剪" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="890" width="820" height="30" as="geometry"/></mxCell>
        <mxCell id="d6_fc" value="③ 末端 LP 硬投影（final_project = true，只跑一次）" style="group" vertex="1" parent="1"><mxGeometry x="1580" y="130" width="780" height="420" as="geometry"/></mxCell>
        <mxCell id="d6_fp1" value="ALM 每步预算固定且整批可行即早停 ⇒ 结束时未必满足冻结约束包&lt;br&gt;（实测 420 样本中 53 个残余违规为正）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="180" width="700" height="64" as="geometry"/></mxCell>
        <mxCell id="d6_fp2" value="\(\min_Q\sum_i\|\Delta Q_i\|_1\)　s.t.　\(Mq\le v\)&lt;br&gt;每段 4 个 Bézier 控制点落在职责区域内；端点 S、G 作硬等式" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="258" width="700" height="66" as="geometry"/></mxCell>
        <mxCell id="d6_fp3" value="HiGHS 精确求解 LP（projection_workers = 1 串行）；已可行样本原样返回" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="338" width="700" height="50" as="geometry"/></mxCell>
        <mxCell id="d6_fp4" value="可行性证书：\(\max(Mq-v)\le\) final_project_tol = 1e−9&lt;br&gt;LP 不可行则保留输入并标 hard_project_feasible = False" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="402" width="700" height="66" as="geometry"/></mxCell>
        <mxCell id="d6_out" value="\(Q^{final}\) → 解码（D5 ⑥）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1620" y="482" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="d6_nt1" value="关键参数（论文配置 C=48）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1150" height="320" as="geometry"/></mxCell>
        <mxCell id="d6_nt1_0" value="inner_steps = 10；activation_inner_steps = 8（首次激活那一步）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1090" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt1_1" value="step_size η = 0.05　rho = 5.0　proximity_weight = 1.0" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1112" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt1_2" value="correction_smooth_weight = 0.1（实际几乎无效，真正的杠杆是下面这个）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1134" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt1_3" value="correction_smooth_kernel = 3，σ = 0（三角核）：把每步位移沿控制轴低通" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1156" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt1_4" value="max_curve_step_scene = 0.20（C=48 配置覆盖；基座 config_160k8p 为 0.03）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1178" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt1_5" value="constraint_tol = 1e−3（早停判据）　scene_to_meter = 80（1 scene = 80 m）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1200" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt1_6" value="final_project = true，final_project_tol = 1e−9，projection_workers = 1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1222" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt2" value="易错点（代码为准）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1230" y="1060" width="1130" height="320" as="geometry"/></mxCell>
        <mxCell id="d6_nt2_0" value="· 信任域限制的是★真实曲线位移★ \(\max_i\|(B\,\mathrm{step})_i\|\)，不是控制点范数" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1090" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt2_1" value="· 没有信任域时累计位移会发散：420 样本里 26 个控制点变 NaN（实测）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1112" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt2_2" value="· 端点每步都钉回 \(Q_0=S\)、\(Q_{C-1}=G\)；\(\Delta\) 是相对 \(Q^{raw}\) 的累计量" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1134" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt2_3" value="· 非活跃面的乘子恒为 0（mask 外永远不激活）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1156" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt2_4" value="· 对偶 λ 跨反向步继承（inherit_dual_across_reverse_steps = true）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1178" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt2_5" value="· 控制轴低通是「让邻居跟随」的关键：不加它曲线会在被修的控制点处起折" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1200" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d6_nt2_6" value="· 末端硬投影是 LP 精确解 + 证书，不是再跑一遍 ALM 迭代" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1222" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="e_d6_corr_d6_resp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endSize=4;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Times New Roman;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6_corr" target="d6_resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d6_resp_d6_sub" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endSize=4;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Times New Roman;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6_resp" target="d6_sub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
