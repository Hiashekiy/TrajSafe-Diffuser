        <mxCell id="d4_tsin" value="正弦编码 sin/cos(t·f)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1640" y="240" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="d4_tmlp" value="Linear(D→D) → SiLU → Linear(D→D)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1640" y="302" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="d4_htout" value="\(h_t\) [B,128] → 所有 AdaLN" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1640" y="364" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="d4_occ" value="𝒪 [B,1,256,256]" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="180" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d4_stem" value="stem：Conv3×3(1→32)+GN+SiLU　256²" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="244" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="d4_s1" value="stage1：32→64，s2　128² (64ch)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="300" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="d4_s2" value="stage2：64→96，s2　64² (96ch)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="356" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="d4_s3" value="stage3：96→128，s2　32² (128ch)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="412" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="d4_s4" value="stage4：128→128，s2　16² (128ch)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="468" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="d4_bn" value="bottleneck Conv3×3(128→128)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="524" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="d4_out" value="out：Conv1×1(128→128)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="580" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="d4_cgout" value="\(C_G\) 256 token [B,256,128]" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="636" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d4_dec" value="细几何解码器：16→32 up(⊕F32 128ch)&lt;br&gt;→ 32→64 up(⊕F64 96ch) → merge s2" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="696" width="320" height="62" as="geometry"/></mxCell>
        <mxCell id="d4_ceout" value="\(C_E\) 1024 token [B,1024,128]" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2000" y="770" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d4_note" value="SceneCNN 的两条记忆：\(C_G\)（16×16 → 256 token，全局）与 \(C_E\)（32×32 → 1024 token，细几何）&lt;br&gt;两者都是 flatten 后 \(+\,\Phi_{xy}(\mathrm{grid})\)；\(C_E\) 只被 D2 的几何注意力查询一次" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="840" width="700" height="70" as="geometry"/></mxCell>
        <mxCell id="d4_nt1" value="结构约束（易错点）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1150" height="380" as="geometry"/></mxCell>
        <mxCell id="d4_nt1_0" value="· 无 token type / role embedding；控制 token(C) 与安全 query(Q) 不做通道拼接" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1030" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt1_1" value="· AdaLN 的 mod 层 zero-init：训练初期 block 退化为「LN + 注意力 + FFN」" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1052" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt1_2" value="· 相对索引偏置表 rel_bias_len = 128 与 token 数解耦（C=32→48 仍能加载旧 ckpt）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1074" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt1_3" value="· 主干输入只有 \(Q_t\)、\(C_G\)、\(h_t\)；S / G 只经零参数算子进入" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1096" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt1_4" value="· TrajBlock 对 token 数不敏感：horizon 只决定相对偏置表长度" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1118" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt1_5" value="· SkeletonTransformer 用的是 nn.TransformerEncoderLayer（无 AdaLN、无 C_G）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1140" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt1_6" value="· \(C_E\) 只在 D2 查询一次；主干与最终去噪器只读 \(C_G\)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1162" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt2" value="关键尺寸" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1230" y="1000" width="1130" height="380" as="geometry"/></mxCell>
        <mxCell id="d4_nt2_0" value="C = 48 控制点（config.yaml 旧值 32）　\(N_T\) = 8　\(N_F\) = 3（D5）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1030" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt2_1" value="D = 128　heads = 4　\(d_h\) = 32　FFN = 512　dropout = 0" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1052" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt2_2" value="\(C_G\) = 16×16 → 256 token　\(C_E\) = 32×32 → 1024 token" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1074" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt2_3" value="SceneCNN 通道：1→32→64→96→128→128；解码器 skip = F32(128ch) / F64(96ch)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1096" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt2_4" value="\(\Phi_{xy}\)：scale = 128，base = 10⁴　PE_1D 零参数" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1118" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt2_5" value="时间步嵌入：正弦 → Linear(D→D) → SiLU → Linear(D→D)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1140" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d4_nt2_6" value="map_res = 256，global_mem_res = 16，geo_mem_res = 32" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1162" width="1102" height="20" as="geometry"/></mxCell>
