  <diagram id="d7" name="D7-DDIM与反馈闭环">
    <mxGraphModel dx="2400" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1420" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d7_title" value="D7 ｜ §3.4-b 闭环：三段状态机（WARMUP → TRY_ACTIVATE → GUIDED）+ DDIM（消费 \(Q^{safe}\)）+ 历史安全反馈回灌 + 末端校验" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2200" height="28" as="geometry"/></mxCell>
        <mxCell id="d7_foot" value="对应代码：diffusion/sampler.py:404 sample · :278 feedback_step · :164 try_activate_corridor · :769-777 DDIM · models/trajsafe/feedback.py:54/:80 · configs/config_160k4p_c48_oneshot.yaml ← config_160k8p.yaml" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="2320" height="22" as="geometry"/></mxCell>
        <mxCell id="d7_legend" value="图例：圆形 + = 残差相加　立方体 = 张量 / 状态　紫色虚线箭 = 时间步 \(h_t\) 注入　蓝色虚线箭 = 场景记忆 \(C_G/C_E\)　红色虚线箭 = 历史安全反馈　绿色虚线箭 = 走廊 / 约束包　紫色虚线框 = 重复模块" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="2320" height="22" as="geometry"/></mxCell>
        <mxCell id="d7_fa" value="① 采样状态机（预热按「已执行的反向前向次数」计）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#999999;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#999999;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="620" height="900" as="geometry"/></mxCell>
        <mxCell id="d7_init" value="\(q\sim\mathcal N(0,I)\) [B,C,2]，\(q_0=S\)，\(q_{C-1}=G\)" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="540" height="50" as="geometry"/></mxCell>
        <mxCell id="d7_warm" value="STATE 1　WARMUP（前 3 次已执行的反向前向）&lt;br&gt;纯反向扩散：无走廊、无 ALM&lt;br&gt;feedback_valid ≡ 0（门控残差是精确恒等）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="540" height="92" as="geometry"/></mxCell>
        <mxCell id="d7_act" value="STATE 2　TRY_ACTIVATE（从第 3 次反向前向开始）&lt;br&gt;一次性拓扑选择 → 128 凸区域 → 重叠检查 → 点种子桥接&lt;br&gt;→ 冻结走廊 + Bézier 约束包（D3 / D6）&lt;br&gt;接受 π 排序中第一条能闭合的候选；失败则继续去噪并重试，&lt;br&gt;最多 max_activation_delay_steps = 2 次，仍失败则该样本退化为纯扩散" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="362" width="540" height="128" as="geometry"/></mxCell>
        <mxCell id="d7_guided" value="STATE 3　GUIDED（拓扑 / 走廊 / 桥接 / 约束包全部冻结）&lt;br&gt;每个反向步：网络前向 → \(Q_t^{raw}\) → ALM → \(Q_t^{safe}\) → DDIM&lt;br&gt;对偶 λ 跨反向步热启动" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="540" height="116" as="geometry"/></mxCell>
        <mxCell id="d7_done" value="循环结束 → 末端 LP 硬投影（D6 ③）→ 解码 + 512 点校验" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="656" width="540" height="50" as="geometry"/></mxCell>
        <mxCell id="d7_l1" value="闭环（一次反向步）：&lt;br&gt;\(Q_t\) → 网络（D4 / D1 / D2 / D5）→ \(Q_t^{raw}\) → ALM（D6）→ \(Q_t^{safe}\)&lt;br&gt;→ DDIM → \(Q_{t-1}\) → 下一步网络 …&lt;br&gt;&lt;br&gt;同一时刻 \(Q_t^{safe}\) 与 \(\Delta Q_t\) 写入反馈缓存，&lt;br&gt;成为下一次前向的第三路输入（D4 的反馈门控残差）。&lt;br&gt;&lt;br&gt;训练链上不存在这条回环：ALM / 走廊 / 反馈缓存全部只发生在推理期。" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="d7_c1" value="网络前向" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="180" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="d7_c2" value="ALM（D6）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="d7_c3" value="DDIM 更新" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="d7_ftok_t0" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="990" y="380" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d7_ftok_t1" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1013" y="380" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d7_ftok_t2" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1036" y="380" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d7_ftok_t3" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1059" y="380" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d7_ftok_t4" value="" style="rounded=1;arcSize=30;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1082" y="380" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="d7_ftok_lbl" value="5 维反馈 [x,y,Δx,Δy,valid]" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="950" y="400" width="195" height="18" as="geometry"/></mxCell>
        <mxCell id="d7_fb" value="② DDIM 反向更新（每个反向步一次）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#9673A6;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="620" height="340" as="geometry"/></mxCell>
        <mxCell id="d7_x0" value="\(\varepsilon=(q-\sqrt{\bar\alpha_t}Q_0)/\sqrt{1-\bar\alpha_t}\)&lt;br&gt;\(Q_0=Q_t^{safe}\)（safe_prediction_to_ddim = true）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="180" width="540" height="62" as="geometry"/></mxCell>
        <mxCell id="d7_upd" value="\(q\leftarrow\sqrt{\bar\alpha_s}Q_0+\sqrt{1-\bar\alpha_s}\varepsilon\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="258" width="540" height="50" as="geometry"/></mxCell>
        <mxCell id="d7_pin" value="\(q\leftarrow\mathrm{hard\_control\_endpoints}(q,\mathrm{cond})\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="324" width="540" height="50" as="geometry"/></mxCell>
        <mxCell id="d7_l2" value="消融：safe_prediction_to_ddim = false 时 DDIM 消费 \(Q_t^{raw}\)&lt;br&gt;（历史反馈仍在）—— 把「反馈」与「安全状态更新」分离" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1120" y="390" width="540" height="60" as="geometry"/></mxCell>
        <mxCell id="d7_fc" value="③ 历史安全反馈（model.feedback.enabled）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#9673A6;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="1280" height="530" as="geometry"/></mxCell>
        <mxCell id="d7_f1" value="每步结算&lt;br&gt;feedback_control = \(Q_{prev}^{safe}\)（上一步本就安全时取 \(Q_{prev}^{raw}\)）&lt;br&gt;feedback_delta = \(Q^{safe}-Q^{raw}\)&lt;br&gt;feedback_valid = 上一步 ALM 输出是否通过冻结约束包" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="550" width="600" height="96" as="geometry"/></mxCell>
        <mxCell id="d7_f2" value="未被接受的步不作为历史：保留最近一次通过校验的反馈&lt;br&gt;（feedback_accept_tol = 1e−2）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="664" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="d7_f3" value="FeedbackEncoder：逐控制点 MLP&lt;br&gt;\([x,y,\Delta x,\Delta y,valid]\) → 5 → 64 → D&lt;br&gt;（末层 zero-init）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1780" y="550" width="580" height="78" as="geometry"/></mxCell>
        <mxCell id="d7_f4" value="FeedbackFusion 门控残差&lt;br&gt;\(gate=\sigma(\mathrm{Linear}([h_{ctrl};h_{fb}]))\cdot valid\)&lt;br&gt;\(h_{ctrl}\leftarrow h_{ctrl}+gate\odot h_{fb}\)" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1780" y="646" width="580" height="78" as="geometry"/></mxCell>
        <mxCell id="d7_fp" value="+" style="ellipse;aspect=fixed;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;fontSize=14;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1403" y="750" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="d7_fout" value="\(\tilde H_Q\)（喂给下一步的网络前向）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="820" width="600" height="50" as="geometry"/></mxCell>
        <mxCell id="d7_nt1" value="关键参数（论文配置）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1150" height="320" as="geometry"/></mxCell>
        <mxCell id="d7_nt1_0" value="warmup_reverse_steps = 3　activation_inner_steps = 8　inner_steps = 10" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1090" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt1_1" value="step_size = 0.05　rho = 5.0　constraint_tol = 1e−3　feedback_accept_tol = 1e−2" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1112" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt1_2" value="correction_smooth_kernel = 3　max_curve_step_scene = 0.20（C=48 覆盖）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1134" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt1_3" value="final_project = true，final_project_tol = 1e−9　scene_to_meter = 80" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1156" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt1_4" value="DDIM 16 步（加速配置 4 步）× region_stride {1, 8}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1178" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt1_5" value="max_activation_delay_steps = 2　feedback.drop_prob = 0.25（训练期）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1200" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt1_6" value="训练期 rollout：feedback.step2_weight = 0.5，topology = expert" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1222" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt2" value="易错点（代码为准）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1230" y="1060" width="1130" height="320" as="geometry"/></mxCell>
        <mxCell id="d7_nt2_0" value="· 预热按「已执行的反向前向次数」而非绝对 t，DDIM 子采样不改变预热语义" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1090" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt2_1" value="· WARMUP 段 feedback_valid ≡ 0，门控残差是精确恒等（不是近似不变）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1112" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt2_2" value="· 走廊 / 桥接 / 约束包只构建一次并冻结，绝不每个反向步重建" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1134" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt2_3" value="· DDIM 消费 \(Q_t^{safe}\)；只有消融变体用 \(Q_t^{raw}\)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1156" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt2_4" value="· 末端 LP 硬投影在反向循环之后、解码之前，只跑一次" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1178" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt2_5" value="· sampler.py 顶部注释「没有末端投影」已过期（代码为准）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1200" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d7_nt2_6" value="· 未被接受的 ALM 结果不进入历史：保留最近一次通过校验的反馈" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1222" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="e_d7_init_d7_warm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endSize=4;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Times New Roman;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d7_init" target="d7_warm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d7_warm_d7_act" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endSize=4;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Times New Roman;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d7_warm" target="d7_act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d7_act_d7_guided" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endSize=4;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Times New Roman;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d7_act" target="d7_guided"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d7_guided_d7_done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;endSize=4;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontFamily=Times New Roman;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d7_guided" target="d7_done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
