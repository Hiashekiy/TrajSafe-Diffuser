        <mxCell id="d5_ftok_lbl" value="C 个控制 token" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="218" height="18" as="geometry"/></mxCell>
        <mxCell id="d5_fd" value="④ FinalDenoiser　\(\times N_F=3\)（结构与 D4 相同，参数独立）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#9673A6;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="760" height="540" as="geometry"/></mxCell>
        <mxCell id="d5_blk" value="TrajBlock：AdaLN 自注意力 → AdaLN 全局图 cross-attn → AdaLN FFN&lt;br&gt;（每个 block 三处 AdaLN 注入 \(h_t\)）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="550" width="680" height="62" as="geometry"/></mxCell>
        <mxCell id="d5_cg" value="\(C_G\) [B,256,128]&lt;br&gt;cross-attn 的 K/V" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="632" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="d5_ht" value="\(h_t\) [B,128]&lt;br&gt;每个 AdaLN 注入" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="632" width="340" height="48" as="geometry"/></mxCell>
        <mxCell id="d5_hclean" value="\(H_{clean}\) [B,C,128]" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="680" height="50" as="geometry"/></mxCell>
        <mxCell id="d5_l4" value="完全独立参数：D4 的 \(N_T=8\) 与这里的 \(N_F=3\) 不共享任何权重" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="660" y="770" width="680" height="40" as="geometry"/></mxCell>
        <mxCell id="d5_hc2" value="\(H_{ctrl}\)（D4，coarse）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="60" width="260" height="46" as="geometry"/></mxCell>
        <mxCell id="d5_hcl2" value="\(H_{clean}\)（final）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1900" y="60" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="d5_fe" value="⑤ 共享控制头 + 固定端点解码" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#9673A6;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="920" height="380" as="geometry"/></mxCell>
        <mxCell id="d5_hp" value="head_p：Linear(D→2)　★ coarse 与 final 是同一层权重（共享，不复制）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="190" width="840" height="56" as="geometry"/></mxCell>
        <mxCell id="d5_qraw" value="\(\tilde Q_{raw}\) [B,C,2]" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="262" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="d5_bd" value="BoundaryDecoder（零参数、永不训练）&lt;br&gt;\(e_s=S-\tilde Q_0\)，\(e_g=G-\tilde Q_{C-1}\)；\(w^s=[1,0.75,0.5,0.25,0,\dots]\)，\(w^g\) 为末端镜像&lt;br&gt;\(Q^*_i=\tilde Q_i+w^s_i e_s+w^g_i e_g\)　⇒　\(Q^*_0=S\)，\(Q^*_{C-1}=G\) 精确成立" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="330" width="840" height="90" as="geometry"/></mxCell>
        <mxCell id="d5_qstar" value="\(Q^*\) [B,C,2]（端点精确）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="438" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="d5_ff" value="⑥ 曲线解码与验证（链尾，不参与训练损失）" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#9673A6;spacingLeft=8;spacingTop=5;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1400" y="540" width="920" height="420" as="geometry"/></mxCell>
        <mxCell id="d5_bmat" value="B：三次 B 样条基矩阵（128×C，clamped 节点，零参数）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="590" width="840" height="46" as="geometry"/></mxCell>
        <mxCell id="d5_curve" value="\(\tau=B\cdot Q^*\) → [B,128,2]（等参数 128 点）" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="654" width="840" height="46" as="geometry"/></mxCell>
        <mxCell id="d5_ver" value="碰撞校验：曲线等参数采样 512 点" style="rounded=1;arcSize=8;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="718" width="840" height="46" as="geometry"/></mxCell>
        <mxCell id="d5_l5" value="训练链上没有 \(L_{traj}\)：128 点曲线只在链尾解码两次&lt;br&gt;· coarse：无候选样本的 fallback（参与 torch.where）&lt;br&gt;· final：验证指标（RMSE / 碰撞）&lt;br&gt;诊断用的 input_curve / raw_curve 在 no_grad 下计算，不进计算图" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1440" y="784" width="840" height="150" as="geometry"/></mxCell>
        <mxCell id="d5_nt1" value="结构约束（易错点）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1150" height="300" as="geometry"/></mxCell>
        <mxCell id="d5_nt1_0" value="· 三个 latent 只做通道拼接后 MLP 融合：无 interleaved token 流、无 type embedding" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1110" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt1_1" value="· SafetyControlFusion 的 out 零初始化 ⇒ 微调起点严格等价于恒等映射" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1132" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt1_2" value="· D-C48 消融没有 \(H_{ell}\) 流：FusionMLP 变 2 流（LN(2D) → Linear(2D→2D) → GELU → Linear(2D→D)）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1154" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt1_3" value="· 端点 S、G 从不被编码：只经 hard_control_endpoints（D4）与 BoundaryDecoder 两个零参数算子" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1176" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt1_4" value="· head_p 共享是硬约束：coarse 与 final 必须来自同一个 Linear(D→2)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1198" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt1_5" value="· \(H_{safe\_ctrl}\) 流的 query 数是 C（控制点），K/V 数是 Q（安全 query）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="1220" width="1122" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt2" value="关键尺寸" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1230" y="1080" width="1130" height="300" as="geometry"/></mxCell>
        <mxCell id="d5_nt2_0" value="\(N_F\) = 3　融合流数 = 3 → LayerNorm(384)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1110" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt2_1" value="head_hidden = 256　D = 128　heads = 4" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1132" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt2_2" value="boundary span = 4，profile = [1.0, 0.75, 0.5, 0.25]（\(k=\min(span,C//2)\)）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1154" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt2_3" value="曲线 128 点；验证采样 512 点；DDIM 步数 16 / 4（D7）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1176" width="1102" height="20" as="geometry"/></mxCell>
        <mxCell id="d5_nt2_4" value="coarse 与 final 各自解码一次：coarse 供 fallback，final 供指标" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1244" y="1198" width="1102" height="20" as="geometry"/></mxCell>
