  <diagram id="bb" name="图3-2b-§3.3控制主干(8×TrajBlock)">
    <mxGraphModel dx="2400" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="980" math="1" shadow="0">
      <root>
