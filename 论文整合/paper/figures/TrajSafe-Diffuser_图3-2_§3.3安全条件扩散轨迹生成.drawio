        <mxCell id="bb_out" value="\(H_{ctrl}\) [B,C,128]&lt;br&gt;→ D1 MatchBlock / D5 head_p" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="250" width="340" height="62" as="geometry" /></mxCell>
        <mxCell id="bb_nt" value="要点（代码为准）" style="rounded=1;arcSize=4;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1000" height="130" as="geometry" /></mxCell>
        <mxCell id="bb_nt_0" value="· 8 层权重完全独立；同一 TrajBlock 类在 D5 的 FinalDenoiser 里复用但另有一套参数" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="74" y="610" width="972" height="20" as="geometry" /></mxCell>
        <mxCell id="bb_nt_1" value="· AdaLN 的 mod 层 zero-init ⇒ 训练起点等价于 LN+注意力+FFN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="74" y="632" width="972" height="20" as="geometry" /></mxCell>
        <mxCell id="bb_nt_2" value="· 主干输入只有 \(Q_t\) / \(C_G\) / \(h_t\)；起终点 S、G 只经零参数算子进入" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="74" y="654" width="972" height="20" as="geometry" /></mxCell>
