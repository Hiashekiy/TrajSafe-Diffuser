        <mxCell id="1" parent="0" />
        <mxCell id="bb_title" value="图 3-2b ｜ §3.3 控制主干：Control Backbone = 8 × TrajBlock（输入 → 主干 → 反馈门控 → 输出 \(H_{ctrl}\)）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2200" height="28" as="geometry" /></mxCell>
        <mxCell id="bb_foot" value="对应代码：blocks.py:81 TrajBlock · blocks.py:34 TrajSelfAttention · common/blocks.py:20 AdaLN · planner.py:180-187（8 层主干 + 共享 head_p）· feedback.py:80 FeedbackFusion ｜ C=48, D=128, heads=4, FFN=512" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="2320" height="22" as="geometry" /></mxCell>
        <mxCell id="bb_legend" value="图例：圆形 + = 残差相加　立方体 = 张量 / 状态　紫色虚线箭 = 时间步 \(h_t\) 注入　蓝色虚线箭 = 场景记忆 \(C_G/C_E\)　红色虚线箭 = 历史安全反馈　绿色虚线箭 = 走廊 / 约束包　紫色虚线框 = 重复模块" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="2320" height="22" as="geometry" /></mxCell>
        <mxCell id="bb_t0" value="\(T^0\) [B,C,128]&lt;br&gt;（控制 token 编码：\(\Phi_{xy}\)+MLP_T+PE_1D）" style="shape=cube;size=10;darkOpacity=0.05;darkOpacity2=0.1;backgroundOutline=1;boundedLbl=1;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="300" height="58" as="geometry" /></mxCell>
