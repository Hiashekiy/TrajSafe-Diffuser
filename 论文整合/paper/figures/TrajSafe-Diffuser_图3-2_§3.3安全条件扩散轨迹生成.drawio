        <mxCell id="d4_ce_lbl" value="\(C_E\) = 32×32 = 1024 token" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1810" y="488" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="d4_noteA" value="板高 = 空间分辨率，板数与厚度 = 通道数：编码器 256²→128²→64²→32²→16²（通道 1→32→64→96→128），解码器 16²→Up⊕32²→Up⊕64²→s2 32² = \(C_E\)；虚线 = skip（编码器中间特征 concat 进 Up）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="1780" height="60" as="geometry" /></mxCell>
