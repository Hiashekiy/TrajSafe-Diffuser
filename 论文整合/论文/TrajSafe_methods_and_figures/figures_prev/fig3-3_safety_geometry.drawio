        <mxCell id="prior_note" parent="1" vertex="1" value="Illustration: \(\bar\alpha=1,\ \sigma=0.25\)" style="html=1;fontFamily=Times New Roman;fontColor=#273344;text;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;spacing=0;fillColor=none;strokeColor=none;">
          <mxGeometry x="50.0" y="490.0" width="315.0" height="27.0" as="geometry" />
        </mxCell>
        <mxCell id="position_query" parent="1" vertex="1" value="&lt;div&gt;&lt;b&gt;Query content + position encoding&lt;/b&gt;&lt;/div&gt;&lt;div&gt;\(q_{e,i}=H_{\Gamma,i}+\mathrm{MLP}_C(\Phi_{xy}(c_i))\)&lt;/div&gt;&lt;div&gt;\(q_i=W_Q\,\mathrm{AdaLN}(q_{e,i},h_t)\)&lt;/div&gt;" style="html=1;fontFamily=Times New Roman;fontColor=#273344;rounded=1;arcSize=8;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;spacing=7;fillColor=#FFFFFF;strokeColor=#42779B;strokeWidth=1.4;">
          <mxGeometry x="390.0" y="120.0" width="610.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="distance_bias" parent="1" vertex="1" value="&lt;div&gt;&lt;b&gt;Distance-based logit bias&lt;/b&gt;&lt;/div&gt;&lt;div&gt;\(B_{ij}=\mathrm{clip}\left(-\bar\alpha\,\frac{\lVert g_j-c_i\rVert^2}{2\sigma^2},-8,0\right)\)&lt;/div&gt;&lt;div&gt;\(g_j\): map-token position; \(\sigma=0.25,\ \bar\alpha\geq0\)&lt;/div&gt;" style="html=1;fontFamily=Times New Roman;fontColor=#273344;rounded=1;arcSize=8;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;spacing=7;fillColor=#FFFFFF;strokeColor=#42779B;strokeWidth=1.4;">
          <mxGeometry x="390.0" y="220.0" width="610.0" height="95.0" as="geometry" />
        </mxCell>
        <mxCell id="biased_attention" parent="1" vertex="1" value="&lt;div&gt;&lt;b&gt;Apply the bias before Softmax&lt;/b&gt;&lt;/div&gt;&lt;div&gt;\(w_{ij}=\mathrm{softmax}_j\left(\frac{q_i^\top k_j}{\sqrt{d_h}}+B_{ij}\right)\)&lt;/div&gt;&lt;div&gt;\(H_{\mathrm{ell},i}=q_{e,i}+\sum_j w_{ij}v_j\)&lt;/div&gt;" style="html=1;fontFamily=Times New Roman;fontColor=#273344;rounded=1;arcSize=8;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;spacing=7;fillColor=#FFFFFF;strokeColor=#42779B;strokeWidth=1.4;">
          <mxGeometry x="390.0" y="347.0" width="610.0" height="95.0" as="geometry" />
        </mxCell>
        <mxCell id="bias_to_softmax" parent="1" edge="1" source="distance_bias" target="biased_attention" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42779B;strokeWidth=1.8;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="actual_weight_note" parent="1" vertex="1" value="Equal feature similarity: farther tokens receive less weight.&lt;br&gt;Actual attention combines feature similarity and spatial bias." style="html=1;fontFamily=Times New Roman;fontColor=#273344;text;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;spacing=0;fillColor=none;strokeColor=none;">
