        <mxCell id="query_center_key" parent="1" vertex="1" value="&lt;font color=&quot;#C63F3B&quot;&gt;●&lt;/font&gt; Query center \(c_i\)" style="html=1;fontFamily=Times New Roman;fontColor=#273344;text;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;spacing=0;fillColor=none;strokeColor=none;">
          <mxGeometry x="57.0" y="411.0" width="300.0" height="29.0" as="geometry" />
