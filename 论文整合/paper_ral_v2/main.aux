\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Local safety feature extraction and ellipse prediction. Selected-route features $\mathbf  Z_\ast ^{\mathrm  {route}}$ are mapped to queries $\mathbf  Z_t^{\mathrm  {query}}$, which attend to map features $\mathbf  Z^{\mathrm  {map}}$ through time-conditioned cross-attention with a spatial distance bias. Residual fusion yields safety geometry features $\mathbf  Z_t^{\mathrm  {geometry}}$ and predicts local ellipse parameters $\bm  {\eta }_i$.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:safety}{{2}{4}{Local safety feature extraction and ellipse prediction. Selected-route features $\mathbf Z_\ast ^{\mathrm {route}}$ are mapped to queries $\mathbf Z_t^{\mathrm {query}}$, which attend to map features $\mathbf Z^{\mathrm {map}}$ through time-conditioned cross-attention with a spatial distance bias. Residual fusion yields safety geometry features $\mathbf Z_t^{\mathrm {geometry}}$ and predicts local ellipse parameters $\boldsymbol \eta _i$}{figure.2}{}}
